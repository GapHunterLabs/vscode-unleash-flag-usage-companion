{
  "name": "unleash-flag-usage-companion",
  "displayName": "Unleash Flag Usage Companion",
  "description": "Inventories Unleash feature flag usage across your codebase -- naming check, find-all-usages, stale-looking flags. No data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "unleash",    "feature-flags",    "inventory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-unleash-flag-usage-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-unleash-flag-usage-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unleashFlagUsageCompanion.showInventory",
        "title": "Unleash Flag Usage Companion: Show Flag Inventory"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
